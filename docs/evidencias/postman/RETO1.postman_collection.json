    },
    {
      "name": "Extra - Seguridad",
      "item": [
        {
          "name": "Crear sin token (401)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('401 sin token', function () { pm.response.to.have.status(401); });"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"No deberia crearse\",\n  \"foundedAt\": \"2024-01-01\"\n}" },
            "url": { "raw": "{{baseUrl}}/startups/create", "host": ["{{baseUrl}}"], "path": ["startups", "create"] }
          }
        }
      ]
    }
  ]
