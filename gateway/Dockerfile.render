# gateway/Dockerfile.render
#
# Variante de gateway/Dockerfile especifica para Render
# (docs/DECISIONES.md): identico salvo que copia nginx.render.conf en
# vez de nginx.conf. docker-compose.yml sigue usando el Dockerfile
# original sin cambios.

FROM nginx:1.27-alpine

COPY gateway/nginx.render.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
