# Variables de entorno para docker-compose.yml (raiz del repo).
# Copiar como .env y completar con valores reales para desarrollo local.
# Cada microservicio ademas tiene su propio .env.example dentro de su
# carpeta, con las mismas variables que necesita segun su rol.

DB_NAME=reto1
DB_USER=reto1
DB_PASSWORD=changeme

# Compartido entre auth-service (firma) y los servicios de escritura
# create/update/delete (verifican). Cambiar por un valor real y
# suficientemente largo antes de desplegar.
JWT_SECRET=changeme

# Unico usuario del sistema (brief: "sin tabla de usuarios"). Solo los
# usa auth-service.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Origen exacto del front-end. CORS restringido a este dominio unico
# (no es una lista), lo usan los 9 microservicios (shared/cors.py). En
# produccion, la URL real donde quede desplegado el front (Vercel).
#
# Dos escenarios locales posibles, un solo valor a la vez:
#   - docker-compose up --build completo (frontend containerizado,
#     nginx sirviendo el build de Vite) -> http://localhost:3000
#   - npm run dev dentro de frontend/ (servidor de desarrollo de Vite,
#     con hot reload) -> http://localhost:5173
FRONTEND_ORIGIN=http://localhost:3000

# Build-time (no runtime, ver docs/DECISIONES.md): con que URL del
# gateway se compila el frontend. Opcional aqui — docker-compose.yml
# ya trae este mismo valor como default si no se define.
VITE_API_BASE_URL=http://localhost:8080/v1/api
