# Variables de entorno requeridas por create-startup-service.
# Copiar como .env y completar con valores reales para desarrollo local.

DB_HOST=db
DB_PORT=5432
DB_NAME=reto1
DB_USER=reto1
DB_PASSWORD=changeme

# Debe ser identico al JWT_SECRET de auth-service: este servicio solo
# verifica la firma, no la genera.
JWT_SECRET=changeme
