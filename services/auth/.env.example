# auth-service no usa la base de datos (brief: "sin tabla de usuarios,
# para no ampliar el alcance de la DB"), por eso no necesita DB_*.

# Credenciales del unico usuario del sistema. Cambiar antes de desplegar.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Debe ser identico al JWT_SECRET de los servicios de escritura: este
# es el unico servicio que FIRMA tokens; los demas solo los verifican.
JWT_SECRET=changeme
